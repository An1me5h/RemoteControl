<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/ConfigLabel"
        android:text="Name" />

    <EditText
        android:id="@+id/etCustomKeyLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. New Tab"
        android:inputType="text"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />

    <TextView
        style="@style/ConfigLabel"
        android:layout_marginTop="16dp"
        android:text="Hold these" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cbCustomCtrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ctrl"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/cbCustomAlt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Alt"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/cbCustomShift"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Shift"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/cbCustomWin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Win"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <TextView
        style="@style/ConfigLabel"
        android:layout_marginTop="16dp"
        android:text="Then press" />

    <Spinner
        android:id="@+id/spinnerCustomKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
