<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- status bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_red" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Disconnected"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/latencyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface">

        <Button
            android:id="@+id/tabControl"
            style="@style/TabButton"
            android:text="CONTROL" />

        <Button
            android:id="@+id/tabConfig"
            style="@style/TabButton"
            android:text="CONFIG" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- CONTROL tab -->
        <LinearLayout
            android:id="@+id/controlPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- live PC screen - always shown alongside the trackpad while CONTROL is
                 visible; the quality button includes an OFF state to free all Wi-Fi
                 airtime for input if the video costs too much responsiveness -->
            <FrameLayout
                android:id="@+id/screenPreviewFrame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="8dp"
                android:background="@color/surface">

                <com.remotecontrol.ZoomableImageView
                    android:id="@+id/screenImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/screenStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:text="Screen mirroring off" />

                <TextView
                    android:id="@+id/zoomBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/key_bg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="6dp"
                    android:orientation="horizontal">

                    <!-- Dedicated OFF button - the quality button cycles LOW/MED/HIGH/MAX/OFF
                         one step at a time, which meant reaching OFF from e.g. MAX took 4
                         taps; this jumps straight there in one tap instead. -->
                    <Button
                        android:id="@+id/btnScreenOff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/key_bg"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:text="Off" />

                    <Button
                        android:id="@+id/btnQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/key_bg"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:text="LOW" />
                </LinearLayout>
            </FrameLayout>

            <!-- Shown instead of screenPreviewFrame while recording a custom key - the
                 whole point is to make the keys section the obvious focus, so the screen
                 preview (the most visually busy part of the screen) is replaced by this
                 instead of just sitting there unused. -->
            <TextView
                android:id="@+id/recordingInstructionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/key_bg_active"
                android:padding="14dp"
                android:gravity="center"
                android:textColor="@color/bg"
                android:textStyle="bold"
                android:textSize="14sp"
                android:visibility="gone"
                android:text="Hold down keys to add them to your combo" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.remotecontrol.TrackpadView
                    android:id="@+id/trackpadView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/surface" />

                <!-- The keyboard itself is a self-contained, portable component - see
                     RemoteKeyboardView.kt - with no knowledge of custom keys, which stay
                     here as this app's own concern (persistence, the "+ Custom Key"
                     recording-mode chrome in MainActivity). -->
                <LinearLayout
                    android:id="@+id/keyboardPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@color/surface">

                    <com.remotecontrol.RemoteKeyboardView
                        android:id="@+id/remoteKeyboard"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- custom keys: user-defined combos, e.g. Ctrl+T. Collapsed by
                         default (MainActivity.setupCustomKeys) - with the keyboard itself
                         already tall (modifiers/F-keys/digits/letters/nav/space rows), an
                         always-expanded list here was pushing the actual keyboard out of
                         view. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="6dp"
                        android:paddingBottom="6dp">

                        <Button
                            android:id="@+id/btnToggleCustomKeys"
                            style="@style/KeyButton"
                            android:layout_width="match_parent"
                            android:layout_marginTop="8dp"
                            android:text="▸ Custom Keys" />

                        <LinearLayout
                            android:id="@+id/customKeysContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/customKeysContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />

                            <Button
                                android:id="@+id/btnAddCustomKey"
                                style="@style/KeyButton"
                                android:layout_width="match_parent"
                                android:layout_marginTop="4dp"
                                android:text="+ Custom Key" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- type-and-send: real phone keyboard, sent as one block instead of
                     one KEY packet per character -->
                <LinearLayout
                    android:id="@+id/textPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@color/surface"
                    android:padding="8dp">

                    <EditText
                        android:id="@+id/etTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:hint="Type here, then Send"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:background="@null" />

                    <Button
                        android:id="@+id/btnSendText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/accent"
                        android:text="Send" />

                    <!-- Sends the picked image(s) to the PC, separate from the typed-text
                         flow above - picking and sending are two independent actions, so
                         this row only shows once something's actually been picked.
                         ivPastedImage previews just the first pick; btnSendImage's own
                         text says how many are actually staged when there's more than one. -->
                    <LinearLayout
                        android:id="@+id/imagePreviewRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivPastedImage"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/key_bg"
                            android:scaleType="centerCrop" />

                        <Button
                            android:id="@+id/btnSendImage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="@color/accent"
                            android:text="Send Image" />

                        <Button
                            android:id="@+id/btnClearImage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="14dp"
                            android:text="✕" />
                    </LinearLayout>

                    <!-- Clipboard-paste detection turned out too unreliable across
                         different source apps (dropped in favor of just this) - the
                         system Photo Picker always works and supports picking several at
                         once. -->
                    <Button
                        android:id="@+id/btnPickImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Pick Images from Gallery" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/bottomNavRow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button android:id="@+id/btnLeft" style="@style/ClickButton" android:text="LEFT" />
                <Button android:id="@+id/btnMiddle" style="@style/ClickButton" android:text="MID" />
                <Button android:id="@+id/btnRight" style="@style/ClickButton" android:text="RIGHT" />
                <Button android:id="@+id/btnKeys" style="@style/ClickButton" android:text="KEYS" />
                <Button android:id="@+id/btnText" style="@style/ClickButton" android:text="TEXT" />
            </LinearLayout>

            <!-- Shown instead of bottomNavRow while recording a custom key - "there will
                 be a save button below the keyboard" (explicit request). -->
            <LinearLayout
                android:id="@+id/recordingButtonBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnCancelRecording"
                    style="@style/ClickButton"
                    android:layout_weight="1"
                    android:text="Cancel" />

                <Button
                    android:id="@+id/btnSaveRecording"
                    style="@style/ClickButton"
                    android:layout_weight="2"
                    android:backgroundTint="@color/accent"
                    android:textColor="@color/bg"
                    android:text="Save Custom Key" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONFIG tab -->
        <ScrollView
            android:id="@+id/configPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/ConfigLabel"
                    android:text="Saved Devices" />

                <LinearLayout
                    android:id="@+id/savedDevicesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btnSaveDevice"
                    style="@style/KeyButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="4dp"
                    android:text="+ Save Current Device" />

                <Button
                    android:id="@+id/btnScanQr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/accent"
                    android:textColor="@color/bg"
                    android:text="Scan QR to Connect" />

                <TextView
                    style="@style/ConfigLabel"
                    android:layout_marginTop="20dp"
                    android:text="PC IP address (blank = auto-discover)" />

                <EditText
                    android:id="@+id/etHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:hint="192.168.1.42"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <TextView
                    style="@style/ConfigLabel"
                    android:layout_marginTop="16dp"
                    android:text="PC port" />

                <EditText
                    android:id="@+id/etPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="5201"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/sensitivityLabel"
                    style="@style/ConfigLabel"
                    android:layout_marginTop="16dp"
                    android:text="Sensitivity: 1.4" />

                <SeekBar
                    android:id="@+id/sensitivitySeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="30"
                    android:progress="12" />

                <TextView
                    android:id="@+id/holdThresholdLabel"
                    style="@style/ConfigLabel"
                    android:layout_marginTop="16dp"
                    android:text="Hold threshold: 2.0s" />

                <SeekBar
                    android:id="@+id/holdThresholdSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="13"
                    android:progress="6" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/accent"
                    android:textColor="@color/bg"
                    android:text="Connect" />

                <TextView
                    android:id="@+id/logText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
